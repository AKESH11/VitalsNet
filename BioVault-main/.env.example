# ===== BioVault 2.0 Environment Configuration =====

# Hyperledger Besu (Private L2)
BESU_RPC_URL=http://localhost:8545
BESU_CHAIN_ID=1337
BESU_NODE_PRIVATE_KEY=your_node_key_here

# FastAPI Backend
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_ENV=development

# rPPG / Biometric Configuration
RPPG_WINDOW_SECONDS=8
RPPG_FPS_TARGET=30
RPPG_SEED_BITS=128

# DWT-SVD Watermarking
WATERMARK_STRENGTH=0.1
WATERMARK_EMBED_LEVEL=3

# Forensic Risk API
FORENSIC_API_ENABLED=true
FORENSIC_CONFIDENCE_THRESHOLD=0.85

# IT Rules 2026 Compliance
TAKEDOWN_WINDOW_MINUTES=120
SGI_LABEL_REQUIRED=true
SIM_BINDING_ENABLED=true

# Mobile App Configuration
ENABLE_ZKP=true
ENABLE_PRNU=true
BLE_DISCOVERY_TIMEOUT=30000
